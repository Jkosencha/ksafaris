# Neon (PostgreSQL). Pooled URL for the site, DIRECT (unpooled) URL for migrations.
# Both must keep ?sslmode=require. Never commit the real values.
DATABASE_URL=
DATABASE_URL_DIRECT=
SITE_URL=http://localhost:4321

# Form service endpoint for the "Plan my safari" enquiry form (Formspree, Web3Forms, etc.).
# Leave empty to fall back to opening a pre-filled email.
PUBLIC_ENQUIRY_ENDPOINT=

# Staff dashboard (/office): Supabase project settings, API. See supabase/README.md.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Secret: never share or commit. Used by the server to save website form submissions.
SUPABASE_SERVICE_ROLE_KEY=
