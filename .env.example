# Neon (PostgreSQL). Pooled URL for the site, DIRECT (unpooled) URL for migrations.
# Both must keep ?sslmode=require. Never commit the real values.
DATABASE_URL=
DATABASE_URL_DIRECT=
SITE_URL=http://localhost:4321
# A separate Neon branch for automated tests. It is wiped on every test run.
TEST_DATABASE_URL=

# Optional: send the website forms to an outside form service instead.
# Leave empty to save them into our own database (/api/enquiry).
PUBLIC_ENQUIRY_ENDPOINT=

