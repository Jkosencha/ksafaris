---
// Booking now lives in the one guest form on the contact page ("Ready to book" stage).
// This page keeps /book and /book?tour=<slug> links working.
const target = '/contact?stage=book#plan';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL('/contact', Astro.site).href} />
    <title>Book your safari</title>
    <script is:inline>
      var tour = new URLSearchParams(location.search).get('tour');
      location.replace('/contact?stage=book' + (tour ? '&tour=' + encodeURIComponent(tour) : '') + '#plan');
    </script>
  </head>
  <body>
    <p><a href={target}>Continue to the booking form</a></p>
  </body>
</html>
