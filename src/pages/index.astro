---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import TourCard from '../components/TourCard.astro';
import ReviewBadges from '../components/ReviewBadges.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getReviews } from '../lib/reviews';
import Icon from '../components/Icon.astro';
import TornEdge from '../components/TornEdge.astro';
import PhotoBand from '../components/PhotoBand.astro';
import SplitFeature from '../components/SplitFeature.astro';
import heroImage from '../assets/images/placeholders/amboseli-kilimanjaro.jpg';
import introImage from '../assets/images/lake-nakuru-rhinos.jpg';
import bandImage from '../assets/images/placeholders/mara-plains.jpg';
import whyImage from '../assets/images/placeholders/amboseli-elephant.jpg';
import ctaImage from '../assets/images/placeholders/nakuru-flamingos.jpg';
import logo from '../assets/images/brand/logo.png';
import { COMING_SOON, SITE, TRAVELLER_TYPES } from '../consts';
import { travelAgency } from '../lib/schema';

const destinations = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
const tours = (await getCollection('tours', (t) => t.data.featured)).sort((a, b) => a.data.order - b.data.order);
const logoImg = await getImage({ src: logo, format: 'png' });
const reviews = (await getReviews()).slice(0, 3);

const pillars = [
  {
    title: 'Locally owned',
    text: `A Kenyan company with over ${SITE.foundedYearsAgo} years on the ground: our own guides, our own partners, our own standards.`,
  },
  {
    title: 'Tailor-made',
    text: 'No fixed group departures. Every itinerary is built around your dates, budget and pace.',
  },
  {
    title: 'Sustainable',
    text: 'We support local communities and conservation, and invite guests to see that work first-hand.',
  },
  {
    title: 'End-to-end',
    text: 'We handle everything on the ground, from airport welcome to your final transfer home.',
  },
];
---

<BaseLayout jsonLd={travelAgency(new URL(logoImg.src, Astro.site).href)}>
  <section class="relative isolate overflow-hidden bg-ink-900">
    <Image
      src={heroImage}
      alt="A family of elephants walking through a flowering meadow in Amboseli, with snow-capped Mount Kilimanjaro behind"
      widths={[640, 1024, 1440, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-900/90 via-ink-900/60 to-ink-900/10"></div>
    <div class="container-page flex min-h-[32rem] flex-col justify-center py-16 sm:min-h-[38rem]">
      <p class="inline-flex items-center gap-2 self-start rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-mist-100 ring-1 ring-white/20 backdrop-blur">
        <Icon name="award" class="size-4 text-reed-300" />
        Best Tour Agency of the Year 2022
      </p>
      <h1 class="mt-6 max-w-3xl text-white">
        <span class="block font-hand text-3xl text-reed-300 sm:text-4xl">Say where,</span>
        <span class="mt-2 block text-5xl leading-[1.05] uppercase sm:text-7xl">we’ll take you there</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-mist-100">
        Tailor-made safaris across Kenya, Tanzania, Uganda, Rwanda and Zanzibar, designed and run by a locally owned East African team.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact#plan" class="btn-accent px-6 py-3 text-base">Plan my safari</a>
        <a href="/tours" class="btn-outline px-6 py-3 text-base text-white">Browse tours</a>
      </div>
    </div>
    <TornEdge />
  </section>

  <section aria-labelledby="intro" class="container-page py-16 sm:py-20">
    <SplitFeature image={introImage} alt="Three white rhinos grazing beside Lake Nakuru, with flamingos lining the shore behind">
      <p class="eyebrow">About KSafaris</p>
      <h2 id="intro" class="mt-2 text-3xl sm:text-4xl">Your destination specialists for East Africa</h2>
      <p class="mt-5 leading-relaxed text-ink-800">
        KSafaris &amp; African Expeditions is a private, locally owned tours and safari company founded over
        twelve years ago in Kenya. We have grown into one of the leading inbound tour operators in Eastern
        Africa, and were voted <strong>Best Tour Agency of the Year 2022</strong> at the People’s Choice Awards.
      </p>
      <p class="mt-5 font-display text-xl text-ink-900">“{SITE.mission}.”</p>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Who we travel with">
        {TRAVELLER_TYPES.map((t) => <li class="rounded-full bg-white px-3 py-1 text-sm ring-1 ring-mist-300">{t}</li>)}
      </ul>
      <a href="/about" class="btn-outline mt-7 self-start text-moss-700">More about us</a>
    </SplitFeature>
  </section>

  <section aria-labelledby="destinations" class="relative bg-mist-300 py-20 sm:py-24">
    <TornEdge position="top" flip />
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Destinations</p>
          <h2 id="destinations" class="mt-2 text-3xl sm:text-4xl">Where would you like to go?</h2>
        </div>
        <a href="/destinations" class="inline-flex items-center gap-1 font-semibold text-moss-700">
          All destinations <Icon name="arrow" class="size-4" />
        </a>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {destinations.map((d) => <DestinationCard destination={d} />)}
      </div>
      <p class="mt-6 text-sm text-ink-700">
        <span class="font-semibold text-ink-900">Coming soon:</span>
        {COMING_SOON.join(', ')}.
      </p>
    </div>
    <TornEdge />
  </section>

  <section aria-labelledby="tours" class="container-page py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Signature safaris</p>
        <h2 id="tours" class="mt-2 text-3xl sm:text-4xl">Start with one of our favourite routes</h2>
      </div>
      <a href="/tours" class="inline-flex items-center gap-1 font-semibold text-moss-700">
        All tours <Icon name="arrow" class="size-4" />
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tours.map((t) => <TourCard tour={t} />)}
    </div>
  </section>

  <PhotoBand
    image={bandImage}
    alt="A wildebeest and a Thomson’s gazelle on the open grassland of the Maasai Mara, with a lone acacia tree"
    caption="Endless plains, unhurried days"
  />

  <section aria-labelledby="why" class="relative isolate overflow-hidden py-24 text-mist-50 sm:py-28">
    <Image
      src={whyImage}
      alt=""
      widths={[640, 1024, 1440, 2000]}
      sizes="100vw"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-moss-800/85"></div>
    <TornEdge position="top" />
    <div class="container-page">
      <p class="font-hand text-2xl text-reed-300 sm:text-3xl">Why KSafaris</p>
      <h2 id="why" class="mt-2 text-3xl text-white sm:text-4xl">Why travel with us</h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((p) => (
            <li class="border-t-2 border-reed-300 pt-4">
              <h3 class="text-xl text-white">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-mist-100">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <TornEdge flip />
  </section>

  <section aria-labelledby="reviews" class="container-page py-16 text-center sm:py-20">
    <p class="eyebrow">Reviews</p>
    <h2 id="reviews" class="mt-2 text-3xl sm:text-4xl">Read what our travellers say</h2>
    <p class="mx-auto mt-3 max-w-xl text-ink-700">Independent reviews from guests who have travelled with us.</p>
    {
      reviews.length > 0 && (
        <ul class="mt-10 grid gap-6 md:grid-cols-3">
          {reviews.map(({ review, tourTitle }) => (
            <li>
              <ReviewCard review={review} tourTitle={tourTitle} />
            </li>
          ))}
        </ul>
      )
    }
    <ReviewBadges class="mt-10 justify-center" />
    {reviews.length > 0 && <a href="/reviews" class="btn-outline mt-6 text-moss-700 hover:bg-moss-700/5">Read more reviews</a>}
  </section>

  <section class="relative isolate overflow-hidden py-24 text-center text-white sm:py-32">
    <Image
      src={ctaImage}
      alt=""
      widths={[640, 1024, 1440, 2000]}
      sizes="100vw"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-ink-900/55"></div>
    <TornEdge position="top" />
    <div class="container-page">
      <p class="font-hand text-3xl text-reed-300 sm:text-4xl">Say where,</p>
      <h2 class="mt-2 text-3xl sm:text-5xl">Ready to plan your safari?</h2>
      <p class="mx-auto mt-4 max-w-xl text-mist-100">Tell us where you dream of going. We’ll reply with a tailor-made itinerary within one working day.</p>
      <a href="/contact#plan" class="btn-accent mt-8 px-6 py-3 text-base">Plan my safari</a>
    </div>
  </section>
</BaseLayout>
