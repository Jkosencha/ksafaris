---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DestinationCard from '../components/DestinationCard.astro';
import TourCard from '../components/TourCard.astro';
import ReviewBadges from '../components/ReviewBadges.astro';
import Icon from '../components/Icon.astro';
import heroImage from '../assets/images/lake-nakuru-rhinos.jpg';
import logo from '../assets/images/brand/logo.png';
import { COMING_SOON, SITE, TRAVELLER_TYPES } from '../consts';
import { travelAgency } from '../lib/schema';

const destinations = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
const tours = (await getCollection('tours', (t) => t.data.featured)).sort((a, b) => a.data.order - b.data.order);
const logoImg = await getImage({ src: logo, format: 'png' });

const pillars = [
  {
    title: 'Locally owned',
    text: `A Kenyan company with over ${SITE.foundedYearsAgo} years on the ground: our own guides, our own partners, our own standards.`,
  },
  {
    title: 'Tailor-made',
    text: 'No fixed group departures. Every itinerary is built around your dates, budget and pace.',
  },
  {
    title: 'Sustainable',
    text: 'We support local communities and conservation, and invite guests to see that work first-hand.',
  },
  {
    title: 'End-to-end',
    text: 'We handle everything on the ground, from airport welcome to your final transfer home.',
  },
];
---

<BaseLayout jsonLd={travelAgency(new URL(logoImg.src, Astro.site).href)}>
  <section class="relative isolate overflow-hidden bg-bark-900">
    <Image
      src={heroImage}
      alt="Three white rhinos grazing beside Lake Nakuru, with flamingos lining the shore behind"
      widths={[640, 850]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-bark-900/90 via-bark-900/60 to-bark-900/10"></div>
    <div class="container-page flex min-h-[32rem] flex-col justify-center py-16 sm:min-h-[38rem]">
      <p class="inline-flex items-center gap-2 self-start rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-sand-100 ring-1 ring-white/20 backdrop-blur">
        <Icon name="award" class="size-4 text-ochre-300" />
        Best Tour Agency of the Year 2022
      </p>
      <h1 class="mt-5 max-w-2xl text-5xl leading-[1.05] font-semibold text-white sm:text-6xl">
        Say where, <span class="text-ochre-300 italic">we’ll take you there.</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg text-sand-100">
        Tailor-made safaris across Kenya, Tanzania, Uganda, Rwanda and Zanzibar, designed and run by a locally owned East African team.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact#plan" class="btn-accent px-6 py-3 text-base">Plan my safari</a>
        <a href="/tours" class="btn-outline px-6 py-3 text-base text-white">Browse tours</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="intro" class="container-page grid gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow">About KSafaris</p>
      <h2 id="intro" class="mt-2 text-3xl font-semibold sm:text-4xl">Your destination specialists for East Africa</h2>
      <p class="mt-5 text-lg leading-relaxed text-bark-800">
        KSafaris &amp; African Expeditions is a private, locally owned tours and safari company founded over
        twelve years ago in Kenya. We have grown into one of the leading inbound tour operators in Eastern
        Africa, and were voted <strong>Best Tour Agency of the Year 2022</strong> at the People’s Choice Awards.
      </p>
      <a href="/about" class="mt-6 inline-flex items-center gap-1 font-semibold text-terracotta-700 hover:text-terracotta-600">
        More about us <Icon name="arrow" class="size-4" />
      </a>
    </div>
    <div class="rounded-2xl bg-sand-100 p-6 sm:p-8">
      <p class="font-display text-2xl text-bark-900 italic">“{SITE.mission}.”</p>
      <p class="mt-2 text-sm font-medium text-bark-700">Our mission</p>
      <p class="mt-6 text-sm font-semibold text-bark-900">Itineraries for every kind of traveller</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {TRAVELLER_TYPES.map((t) => <li class="rounded-full bg-white px-3 py-1 text-sm ring-1 ring-sand-300">{t}</li>)}
      </ul>
    </div>
  </section>

  <section aria-labelledby="destinations" class="bg-sand-100 py-16 sm:py-20">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Destinations</p>
          <h2 id="destinations" class="mt-2 text-3xl font-semibold sm:text-4xl">Where would you like to go?</h2>
        </div>
        <a href="/destinations" class="inline-flex items-center gap-1 font-semibold text-terracotta-700">
          All destinations <Icon name="arrow" class="size-4" />
        </a>
      </div>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {destinations.map((d) => <DestinationCard destination={d} />)}
      </div>
      <p class="mt-6 text-sm text-bark-700">
        <span class="font-semibold text-bark-900">Coming soon:</span>
        {COMING_SOON.join(', ')}.
      </p>
    </div>
  </section>

  <section aria-labelledby="tours" class="container-page py-16 sm:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Signature safaris</p>
        <h2 id="tours" class="mt-2 text-3xl font-semibold sm:text-4xl">Start with one of our favourite routes</h2>
      </div>
      <a href="/tours" class="inline-flex items-center gap-1 font-semibold text-terracotta-700">
        All tours <Icon name="arrow" class="size-4" />
      </a>
    </div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tours.map((t) => <TourCard tour={t} />)}
    </div>
  </section>

  <section aria-labelledby="why" class="bg-acacia-800 py-16 text-sand-50 sm:py-20">
    <div class="container-page">
      <h2 id="why" class="text-3xl font-semibold text-white sm:text-4xl">Why travel with us</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((p) => (
            <li class="border-t-2 border-ochre-400 pt-4">
              <h3 class="text-xl font-semibold text-white">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-sand-100">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="reviews" class="container-page py-16 text-center sm:py-20">
    <h2 id="reviews" class="text-3xl font-semibold sm:text-4xl">Read what our travellers say</h2>
    <p class="mx-auto mt-3 max-w-xl text-bark-700">Independent reviews from guests who have travelled with us.</p>
    <ReviewBadges class="mt-6 justify-center" />
  </section>

  <section class="container-page">
    <div class="rounded-3xl bg-terracotta-700 px-6 py-12 text-center text-white sm:px-12">
      <h2 class="text-3xl font-semibold sm:text-4xl">Ready to plan your safari?</h2>
      <p class="mx-auto mt-3 max-w-xl text-sand-100">Tell us where you dream of going. We’ll reply with a tailor-made itinerary within one working day.</p>
      <a href="/contact#plan" class="btn-accent mt-6 px-6 py-3 text-base">Plan my safari</a>
    </div>
  </section>
</BaseLayout>
