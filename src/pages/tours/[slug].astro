---
import type { GetStaticPaths } from 'astro';
import { getCollection, getEntries, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import TourCard from '../../components/TourCard.astro';
import Icon from '../../components/Icon.astro';
import PhotoBand from '../../components/PhotoBand.astro';
import RouteMap from '../../components/RouteMap.astro';
import { formatPrice, paragraphs } from '../../lib/format';
import { touristTrip } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const tours = await getCollection('tours');
  return tours.map((tour) => ({ params: { slug: tour.id }, props: { tour } }));
}) satisfies GetStaticPaths;

interface Props {
  tour: CollectionEntry<'tours'>;
}

const { tour } = Astro.props;
const { title, summary, durationDays, route, flyTo, priceFrom, heroImage, heroAlt, itinerary, included, excluded } = tour.data;
const destinations = await getEntries(tour.data.destinations);

const others = (await getCollection('tours'))
  .filter((t) => t.id !== tour.id)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const ogImage = await getImage({ src: heroImage, width: Math.min(1200, heroImage.width), format: 'jpg', quality: 80 });
const jsonLd = touristTrip(
  tour,
  destinations,
  new URL(Astro.url.pathname, Astro.site),
  new URL(ogImage.src, Astro.site),
);
const nights = durationDays - 1;
const facts = [
  { icon: 'clock', label: 'Duration', value: `${durationDays} days / ${nights} nights` },
  { icon: 'pin', label: 'Countries', value: destinations.map((d) => d.data.name).join(', ') },
  { icon: 'tag', label: 'Price', value: formatPrice(priceFrom) },
  { icon: 'award', label: 'Style', value: 'Private, tailor-made' },
] as const;
---

<BaseLayout title={title} description={summary} image={heroImage} imageAlt={heroAlt} type="article" jsonLd={jsonLd}>
  <PageHero title={title} eyebrow={`${durationDays} days · ${destinations.map((d) => d.data.name).join(' & ')}`} image={heroImage} imageAlt={heroAlt}>
    <dl class="mt-8 grid max-w-3xl grid-cols-2 overflow-hidden rounded-md border border-white/25 bg-ink-900/35 text-white backdrop-blur-sm sm:grid-cols-4">
      {
        facts.map((f) => (
          <div class="flex flex-col items-center gap-1 border-white/20 p-4 text-center max-sm:odd:border-r max-sm:nth-[-n+2]:border-b sm:not-last:border-r">
            <Icon name={f.icon} class="size-6 text-reed-300" />
            <dt class="text-[0.7rem] tracking-[0.15em] text-mist-200 uppercase">{f.label}</dt>
            <dd class="text-sm font-medium">{f.value}</dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-6 flex flex-wrap gap-3">
      <a href="#plan" data-set-stage="book" class="btn-accent">Book this safari</a>
      <a href="#plan" data-set-stage="explore" class="btn-outline text-white">Ask a question</a>
    </div>
  </PageHero>

  <nav aria-label="Breadcrumb" class="container-page pt-6 text-sm text-ink-700">
    <ol class="flex flex-wrap gap-1">
      <li><a href="/" class="hover:text-moss-700">Home</a> /</li>
      <li><a href="/tours" class="hover:text-moss-700">Tours</a> /</li>
      <li aria-current="page" class="text-ink-900">{title}</li>
    </ol>
  </nav>

  <div class="container-page mt-6 grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem]">
    <div>
      <p class="text-lg leading-relaxed text-ink-800">{summary}</p>

      {
        route.length > 0 && (
          <section aria-label="Route map" class="mt-8">
            <RouteMap route={route} flyTo={flyTo} countries={destinations.map((d) => d.data.name)} />
          </section>
        )
      }

      <section aria-labelledby="itinerary" class="mt-12">
        <h2 id="itinerary" class="text-3xl font-semibold">Day-by-day itinerary</h2>
        <ol class="mt-6 space-y-0">
          {
            itinerary.map((day) => (
              <li class="relative border-l-2 border-mist-300 pb-10 pl-8 last:border-transparent last:pb-0">
                <span class="absolute top-0 -left-[1.1rem] flex h-8 min-w-8 items-center justify-center rounded-full bg-moss-700 px-2 text-xs font-bold whitespace-nowrap text-white">
                  {day.day}
                </span>
                <h3 class="text-xl font-semibold">
                  <span class="sr-only">Day {day.day}: </span>
                  {day.title}
                </h3>
                <div class="prose-safari mt-3">
                  {paragraphs(day.description).map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
                {(day.overnight || day.mealPlan) && (
                  <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-2 rounded-md bg-mist-100 px-4 py-3 text-sm">
                    {day.overnight && (
                      <div class="flex items-center gap-2">
                        <Icon name="bed" class="size-4 text-moss-700" />
                        <dt class="font-medium">Overnight:</dt>
                        <dd>{day.overnight}</dd>
                      </div>
                    )}
                    {day.mealPlan && (
                      <div class="flex items-center gap-2">
                        <Icon name="plate" class="size-4 text-moss-700" />
                        <dt class="font-medium">Meals:</dt>
                        <dd>{day.mealPlan}</dd>
                      </div>
                    )}
                  </dl>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      {
        (included.length > 0 || excluded.length > 0) && (
          <section aria-labelledby="inclusions" class="mt-14">
            <h2 id="inclusions" class="text-3xl">
              Trip price <span class="text-moss-700">· {priceFrom ? `from US$${priceFrom.toLocaleString('en-US')} per person` : 'on request'}</span>
            </h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2">
              <div class="rounded-md bg-white p-5 ring-1 ring-mist-200">
                <h3 class="text-lg font-semibold text-moss-700">Included</h3>
                <ul class="mt-3 space-y-2 text-sm">
                  {included.map((item) => (
                    <li class="flex gap-2">
                      <Icon name="check" class="mt-0.5 size-4 shrink-0 text-moss-600" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
              <div class="rounded-md bg-white p-5 ring-1 ring-mist-200">
                <h3 class="text-lg font-semibold text-moss-700">Not included</h3>
                <ul class="mt-3 space-y-2 text-sm">
                  {excluded.map((item) => (
                    <li class="flex gap-2">
                      <Icon name="x_mark" class="mt-0.5 size-4 shrink-0 text-moss-600" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="mt-4 text-sm text-ink-700">
              Every itinerary can be tailored. Change the pace, lodges, or add a beach extension.
            </p>
            <a href="#plan" data-set-stage="book" class="btn-primary mt-6">Book this safari</a>
          </section>
        )
      }
    </div>

    <aside class="lg:self-start">
      <EnquiryForm tour={title} />
    </aside>
  </div>

  <PhotoBand
    image={destinations[0].data.heroImage}
    alt={destinations[0].data.heroAlt}
    caption={`Say where, we’ll take you there`}
    class="mt-20"
  />

  {
    others.length > 0 && (
      <section aria-labelledby="more-tours" class="container-page mt-16">
        <h2 id="more-tours" class="text-3xl font-semibold">More safaris</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {others.map((t) => <TourCard tour={t} />)}
        </div>
      </section>
    )
  }
</BaseLayout>
