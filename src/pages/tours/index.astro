---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TourCard from '../../components/TourCard.astro';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const description =
  'Sample safari itineraries across Kenya and Tanzania, each one fully tailor-made to your dates, budget and travel style.';
---

<BaseLayout title="Safari Tours & Itineraries" description={description}>
  <PageHero
    eyebrow="Our products"
    title="Safari tours & itineraries"
    lead="Start from one of our favourite routes, then let us shape it around you. Every safari is private and fully tailor-made."
  />
  <section class="container-page mt-12">
    <h2 class="sr-only">All tours</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tours.map((tour) => <TourCard tour={tour} />)}
    </div>
    <div class="mt-12 rounded-2xl bg-moss-800 p-6 text-mist-50 sm:flex sm:items-center sm:justify-between sm:p-8">
      <div>
        <p class="font-display text-2xl font-semibold text-white">Don’t see your perfect trip?</p>
        <p class="mt-1 text-mist-100">Gorilla trekking, Zanzibar beaches, corporate and MICE travel. Say where, we’ll take you there.</p>
      </div>
      <a href="/contact#plan" class="btn-accent mt-5 shrink-0 sm:mt-0">Plan my safari</a>
    </div>
  </section>
</BaseLayout>
