---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/images/placeholders/amboseli-elephant.jpg';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getReviews } from '../lib/reviews';
import { SOCIAL } from '../consts';

const reviews = await getReviews();

const description =
  'Read independent reviews of KSafaris & African Expeditions on Tripadvisor and SafariBookings.';
const platforms = [
  { name: 'Tripadvisor', href: SOCIAL.tripadvisor, icon: 'tripadvisor' as const, text: 'Guest reviews and photos from our safaris.' },
  { name: 'SafariBookings', href: SOCIAL.safaribookings, icon: 'award' as const, text: 'Africa’s largest safari review platform.' },
];
---

<BaseLayout title="Reviews" description={description}>
  <PageHero image={heroImage} imageAlt="Two elephants grazing in the Amboseli swamps below Mount Kilimanjaro" 
        eyebrow="Reviews"
    title="What our travellers say"
    lead="We’re proud to be rated by our guests on independent review platforms. Read their stories, and if you’ve travelled with us, we’d love to hear yours."
  />


  {
    reviews.length > 0 && (
      <section aria-labelledby="guest-reviews" class="container-page mt-12">
        <h2 id="guest-reviews" class="text-3xl font-semibold">Guest reviews</h2>
        <ul class="mt-6 gap-6 md:columns-2 lg:columns-3">
          {reviews.map(({ review, tourTitle }) => (
            <li class="mb-6 break-inside-avoid">
              <ReviewCard review={review} tourTitle={tourTitle} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section aria-label="Review platforms" class="container-page mt-10 grid gap-6 sm:grid-cols-2">
    {
      platforms.map((p) => (
        <a
          href={p.href}
          target="_blank"
          rel="noopener"
          class="group flex items-center gap-5 rounded-md bg-white p-6 ring-1 ring-mist-200 transition hover:ring-reed-500"
        >
          <span class="flex size-14 shrink-0 items-center justify-center rounded-full bg-moss-700 text-white">
            <Icon name={p.icon} class="size-7" />
          </span>
          <span>
            <span class="block font-display text-xl font-semibold">Read our reviews on {p.name}</span>
            <span class="mt-1 block text-sm text-ink-700">{p.text}</span>
          </span>
          <Icon name="arrow" class="ml-auto size-5 shrink-0 text-moss-700 transition group-hover:translate-x-1" />
        </a>
      ))
    }
  </section>

  <section class="container-page mt-16">
    <div class="rounded-md bg-mist-100 px-6 py-10 text-center sm:px-12">
      <h2 class="text-2xl font-semibold sm:text-3xl">Travelled with us?</h2>
      <p class="mx-auto mt-2 max-w-lg text-ink-700">A short review helps other travellers find us. Thank you!</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={SOCIAL.tripadvisor} target="_blank" rel="noopener" class="btn-primary">Review on Tripadvisor</a>
        <a href={SOCIAL.safaribookings} target="_blank" rel="noopener" class="btn border border-moss-700 text-moss-700 hover:bg-moss-700/5">Review on SafariBookings</a>
      </div>
    </div>
  </section>
</BaseLayout>
