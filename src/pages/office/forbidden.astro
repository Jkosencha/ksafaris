---
export const prerender = false; // shown with status 403 when a role can't open a page
import OfficeLayout from '../../layouts/OfficeLayout.astro';
import { ROLE_LABELS, homeFor } from '../../lib/auth/permissions';

const user = Astro.locals.user;
const home = user ? homeFor(user) : '/office';
---

<OfficeLayout title="Not available">
  <section class="mx-auto mt-10 max-w-lg rounded-xl bg-clay-soft p-8 text-center text-clay-ink">
    <h1 class="font-display text-[28px] uppercase">Not available for your role</h1>
    <p class="mt-3 text-[15px]">
      {user ? `Your account is set up as ${ROLE_LABELS[user.role]}, which can't open this page.` : 'Your account can\'t open this page.'}
      If you need it, ask the Owner to change your role.
    </p>
    <a href={home} class="mt-6 inline-flex min-h-11 items-center rounded-full bg-o-surface px-5 text-sm font-bold text-o-text">Back to your dashboard</a>
  </section>
</OfficeLayout>
