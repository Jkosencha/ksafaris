---
import { Image } from 'astro:assets';
import OfficeLayout from '../../layouts/OfficeLayout.astro';
import { INK, PHOTOS, TONE } from '../../lib/office';
import { CALENDAR_START, RESOURCES, TRIPS, TRIP_STATS } from '../../data/office-sample';

const DAYS = 30;
const start = new Date(`${CALENDAR_START}T00:00:00`);
const days = Array.from({ length: DAYS }, (_, i) => {
  const d = new Date(start);
  d.setDate(start.getDate() + i);
  return { n: d.getDate(), wd: d.toLocaleDateString('en-GB', { weekday: 'narrow' }), weekend: d.getDay() % 6 === 0, today: i === 0 };
});
const end = new Date(start);
end.setDate(start.getDate() + DAYS - 1);
const range = `${start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })} to ${end.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}`;

const bar = { paid: TONE.leaf.solid, awaiting: TONE.gold.solid, noguide: TONE.clay.solid };
const legend = [
  { label: 'Paid', cls: 'bg-leaf' },
  { label: 'Awaiting payment', cls: 'bg-gold' },
  { label: 'Needs a guide', cls: 'bg-clay' },
];
// Day columns: thin lines every day, drawn behind the bars.
const grid = 'grid grid-cols-[repeat(30,minmax(0,1fr))]';
---

<OfficeLayout title="Trips">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="font-display text-[34px] uppercase">Trips</h1>
    <div class="flex items-center gap-2">
      <button type="button" aria-label="Previous 30 days" class="size-11 rounded-full bg-o-surface text-lg">‹</button>
      <span class="min-w-44 text-center font-bold">{range}</span>
      <button type="button" aria-label="Next 30 days" class="size-11 rounded-full bg-o-surface text-lg">›</button>
    </div>
  </div>

  <section aria-label="At a glance" class="grid gap-3.5 sm:grid-cols-2 xl:grid-cols-4">
    {
      TRIP_STATS.map((s) => (
        <div class:list={['flex flex-col-reverse rounded-xl px-4.5 py-3.5', TONE[s.tone].card]}>
          <span class="text-[13px] font-semibold">{s.label}</span>
          <span class="font-display text-[28px]">{s.value}</span>
        </div>
      ))
    }
  </section>

  <section aria-labelledby="calendar" class="flex flex-col gap-3 rounded-xl bg-o-surface p-5">
    <div class="flex flex-wrap items-center justify-between gap-2.5">
      <h2 id="calendar" class="font-display text-xl">Who is out when</h2>
      <ul class="flex flex-wrap gap-4 text-[13px] text-o-soft">
        {
          legend.map((l) => (
            <li class="flex items-center gap-1.5">
              <span aria-hidden="true" class:list={['h-3 w-4.5 rounded-sm', l.cls]} />
              {l.label}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="overflow-x-auto">
      <div class="min-w-[960px]">
        <div class="flex border-b border-o-line2">
          <span class="w-58 shrink-0 py-2 text-xs tracking-wider text-o-muted uppercase">Trip</span>
          <div class:list={['flex-1', grid]}>
            {
              days.map((d) => (
                <span
                  class:list={[
                    'py-1.5 text-center text-xs',
                    d.today ? 'rounded-t-md bg-teal font-bold text-[#0e1d1e]' : d.weekend ? 'bg-o-surface2 text-o-muted' : 'text-o-soft',
                  ]}
                >
                  <span class="block text-[10px]">{d.wd}</span>
                  {d.n}
                  {d.today && <span class="sr-only"> (today)</span>}
                </span>
              ))
            }
          </div>
        </div>
        {
          TRIPS.map((t) => (
            <div class="flex min-h-16 border-b border-o-line">
              <div class="flex w-58 shrink-0 items-center gap-2.5 py-2.5 pr-3">
                <Image src={PHOTOS[t.photo]} alt="" width={88} height={88} class="size-11 shrink-0 rounded-lg object-cover" />
                <span class="flex min-w-0 flex-col gap-0.5">
                  <span class="text-sm font-bold">{t.guest}</span>
                  <span class="text-xs text-o-muted">{t.tour}</span>
                </span>
              </div>
              <div
                class:list={['flex-1 items-center', grid]}
                style="background-image: repeating-linear-gradient(to right, var(--o-line) 0 1px, transparent 1px calc(100% / 30))"
              >
                <span
                  class:list={['row-start-1 flex h-9 items-center overflow-hidden rounded-md px-2.5 text-xs font-bold whitespace-nowrap', bar[t.status]]}
                  style={`grid-column: ${t.start + 1} / span ${Math.min(t.days, DAYS - t.start)}`}
                >
                  {t.label}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="grid gap-5 md:grid-cols-3">
    {
      RESOURCES.map((r) => (
        <section class:list={['rounded-xl p-5', TONE[r.tone].card]}>
          <h2 class="mb-2 font-display text-xl">{r.title}</h2>
          <ul>
            {r.rows.map((row) => (
              <li class="flex items-center justify-between gap-3 py-2 text-sm">
                <span class="font-semibold">{row.name}</span>
                {row.tone ? (
                  <span class:list={['rounded-full bg-o-surface px-2.5 py-0.5 text-xs font-bold whitespace-nowrap', INK[row.tone]]}>{row.status}</span>
                ) : (
                  <span class="text-[13px] opacity-80">{row.status}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</OfficeLayout>
