---
/** Add a booking or enquiry that came in by phone, WhatsApp, email or in person. */
import { getCollection } from 'astro:content';
import OfficeLayout from '../../../layouts/OfficeLayout.astro';

const tours = (await getCollection('tours')).sort((a, b) => a.data.order - b.data.order);
const field = 'mt-1 block min-h-11 w-full rounded-md border border-o-line2 bg-o-surface px-3 text-[15px] font-normal text-o-text placeholder:text-o-muted';
const label = 'text-[13px] font-bold text-o-soft';
const group = 'grid gap-4 rounded-xl bg-o-surface p-5 sm:grid-cols-2 sm:p-6';
const legend = 'mb-1 font-display text-xl uppercase sm:col-span-2';
---

<OfficeLayout title="New booking">
  <nav aria-label="Breadcrumb" class="-mb-3 text-sm text-o-muted">
    <a href="/office/bookings" class="text-o-link">Bookings</a> / New
  </nav>
  <div>
    <h1 class="font-display text-[34px] uppercase">New booking</h1>
    <p class="mt-1.5 text-[15px] text-o-muted">For requests that came by phone, WhatsApp, email or in person. Website requests arrive on their own.</p>
  </div>

  <form class="flex max-w-4xl flex-col gap-5" data-new-booking>
    <fieldset class={group}>
      <legend class="sr-only">Type</legend>
      <p class={legend}>What is it?</p>
      <div role="radiogroup" aria-label="Type" class="grid grid-cols-2 gap-2 sm:col-span-2">
        {
          [
            ['Booking', 'Ready to book', true],
            ['Enquiry', 'Still exploring', false],
          ].map(([value, text, checked]) => (
            <label class="flex min-h-12 cursor-pointer items-center justify-center rounded-lg bg-o-surface2 text-sm font-bold has-checked:bg-teal has-checked:text-[#0e1d1e] has-focus-visible:ring-2 has-focus-visible:ring-gold">
              <input type="radio" name="kind" value={String(value)} checked={Boolean(checked)} class="sr-only" />
              {text}
            </label>
          ))
        }
      </div>
      <label class={label}>Came in by
        <select name="source" class={field}>
          <option>Phone call</option><option>WhatsApp</option><option>Email</option><option>Walk-in</option><option>Agent or partner</option>
        </select>
      </label>
      <label class={label}>Handled by
        <select name="owner" class={field}><option>Kevin</option><option>Amina</option><option>Unassigned</option></select>
      </label>
    </fieldset>

    <fieldset class={group}>
      <legend class="sr-only">Lead guest</legend>
      <p class={legend}>Lead guest</p>
      <label class:list={[label, 'sm:col-span-2']}>Full name *<input name="name" required autocomplete="off" class={field} /></label>
      <label class={label}>Email<input name="email" type="email" class={field} /></label>
      <label class={label}>Phone / WhatsApp<input name="phone" type="tel" class={field} /></label>
      <label class={label}>Country of residence<input name="country" class={field} /></label>
      <label class={label}>Nationality<input name="nationality" class={field} /></label>
    </fieldset>

    <fieldset class={group}>
      <legend class="sr-only">Trip</legend>
      <p class={legend}>Trip</p>
      <label class:list={[label, 'sm:col-span-2']}>Tour
        <select name="tour" class={field}>
          {tours.map((t) => <option>{t.data.title}</option>)}
          <option>Tailor-made safari</option>
          <option>Not decided yet</option>
        </select>
      </label>
      <label class={label}>Start date<input name="start" type="date" class={field} /></label>
      <label class={label}>Dates
        <select name="flex" class={field}><option>Fixed</option><option>Plus or minus a few days</option><option>Flexible within the month</option></select>
      </label>
      <label class={label}>Adults<input name="adults" type="number" min="1" value="2" inputmode="numeric" class={field} /></label>
      <label class={label}>Children<input name="children" type="number" min="0" value="0" inputmode="numeric" class={field} /></label>
      <label class:list={[label, 'sm:col-span-2']}>Notes and special requests
        <textarea name="notes" rows="4" placeholder="Dietary needs, celebrations, budget, what they asked about…" class:list={[field, 'py-2.5']}></textarea>
      </label>
    </fieldset>

    <div class="flex flex-wrap items-center justify-end gap-3">
      <p class="mr-auto text-sm" role="status" aria-live="polite" data-status></p>
      <a href="/office/bookings" class="flex min-h-11 items-center rounded-full bg-o-surface px-5 text-sm font-bold text-o-text">Cancel</a>
      <button type="submit" class="min-h-11 rounded-full bg-teal px-6 text-sm font-bold text-[#0e1d1e]">Save booking</button>
    </div>
  </form>
</OfficeLayout>

<script>
  // Saving needs the database; until then, say so instead of pretending.
  document.querySelector<HTMLFormElement>('[data-new-booking]')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = document.querySelector('[data-status]')!;
    status.className = 'mr-auto rounded-full px-3 py-1 text-sm font-bold bg-gold-soft text-gold-ink';
    status.textContent = 'Saving will work once the database is connected.';
  });
</script>
