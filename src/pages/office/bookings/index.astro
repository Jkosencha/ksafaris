---
import { Image } from 'astro:assets';
import OfficeLayout from '../../../layouts/OfficeLayout.astro';
import { INK, PHOTOS, TONE } from '../../../lib/office';
import { BOOKINGS, MONTH_SUMMARY, TODOS, type Booking, type Tone } from '../../../data/office-sample';

// The board's columns. Paid bookings sit under Confirmed.
const columns: { title: string; tone: Tone; items: Booking[] }[] = [
  { title: 'New', tone: 'teal', items: BOOKINGS.filter((b) => b.stage === 'new') },
  { title: 'Quoted', tone: 'gold', items: BOOKINGS.filter((b) => b.stage === 'quoted') },
  { title: 'Awaiting payment', tone: 'clay', items: BOOKINGS.filter((b) => b.stage === 'awaiting') },
  { title: 'Confirmed', tone: 'leaf', items: BOOKINGS.filter((b) => b.stage === 'confirmed' || b.stage === 'paid') },
];
const requests = BOOKINGS.filter((b) => b.kind === 'Booking').length;
const filters = [
  { key: 'all', label: `All ${BOOKINGS.length}` },
  { key: 'Booking', label: `Booking requests ${requests}` },
  { key: 'Enquiry', label: `Enquiries ${BOOKINGS.length - requests}` },
  { key: 'mine', label: 'Mine' },
];
---

<OfficeLayout title="Bookings">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-[34px] uppercase">Bookings</h1>
      <p class="mt-1.5 text-[15px] text-o-muted">Every enquiry and booking request, from first message to paid.</p>
    </div>
    <div role="group" aria-label="Show" class="flex flex-wrap gap-2">
      {
        filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="min-h-11 rounded-full bg-o-surface px-4 text-sm font-semibold text-o-text aria-pressed:bg-teal aria-pressed:text-[#0e1d1e]"
          >
            {f.label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="flex flex-wrap items-start gap-6">
    <div class="min-w-0 flex-[999_1_640px] overflow-x-auto pb-2">
      <div class="grid min-w-[800px] grid-cols-4 gap-3">
        {
          columns.map((col) => (
            <section aria-label={col.title} class:list={['flex flex-col gap-2.5 rounded-xl p-3', TONE[col.tone].card]}>
              <h2 class="flex items-center gap-2 px-1 pt-1 pb-1.5 font-sans text-[13px] font-bold tracking-wider">
                {col.title}
                <span class="ml-auto" data-count>{col.items.length}</span>
              </h2>
              {col.items.map((b) => (
                <a
                  href={`/office/bookings/${b.id}`}
                  data-kind={b.kind}
                  data-owner={b.owner}
                  class="flex flex-col gap-2 overflow-hidden rounded-lg bg-o-surface text-o-text no-underline shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
                >
                  <Image src={PHOTOS[b.photo]} alt="" width={480} height={176} class="h-22 w-full object-cover" />
                  <div class="flex flex-col gap-2 px-3.5 pb-3.5">
                    <div class="flex items-baseline justify-between gap-2">
                      <span class="text-[15px] font-bold">{b.guest}</span>
                      <span class="text-xs whitespace-nowrap text-o-muted">{b.received}</span>
                    </div>
                    <span class="text-sm text-o-soft">{b.tour}</span>
                    <div class="flex flex-wrap gap-1.5 text-xs">
                      <span class="rounded bg-o-surface2 px-2 py-0.5">{b.start}</span>
                      <span class="rounded bg-o-surface2 px-2 py-0.5">{b.pax}</span>
                      <span
                        class:list={[
                          'rounded px-2 py-0.5 font-bold',
                          b.kind === 'Booking' ? TONE.clay.chip : 'bg-o-surface2 text-o-soft',
                        ]}
                      >
                        {b.kind}
                      </span>
                    </div>
                    <div class="flex items-center justify-between pt-1 text-[13px]">
                      <span class="font-bold">{b.value}</span>
                      <span class="text-o-muted">{b.owner}</span>
                    </div>
                  </div>
                </a>
              ))}
            </section>
          ))
        }
      </div>
    </div>

    <aside aria-label="Today" class="flex flex-[1_1_280px] flex-col gap-4">
      <section class="rounded-xl bg-o-surface p-5">
        <p class="font-hand text-[22px] text-gold-ink">Today</p>
        <h2 class="font-display text-xl">To do</h2>
        <ul class="mt-2">
          {
            TODOS.map((t) => (
              <li>
                <label class="flex min-h-11 items-start gap-2.5 pt-2.5 text-sm">
                  <input type="checkbox" class="mt-0.5 size-4 accent-leaf" />
                  <span>
                    <a href={t.href} class="block text-o-text hover:underline">{t.text}</a>
                    <span class:list={['text-xs', t.tone ? ['font-bold', INK[t.tone]] : 'text-o-muted']}>{t.meta}</span>
                  </span>
                </label>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="rounded-xl bg-teal-soft p-5 text-teal-ink">
        <h2 class="font-display text-xl">This month</h2>
        <dl class="mt-3 grid grid-cols-2 gap-3.5">
          {
            MONTH_SUMMARY.map((m) => (
              <div class="flex flex-col-reverse">
                <dt class="text-[13px]">{m.label}</dt>
                <dd class="font-display text-[28px]">{m.value}</dd>
              </div>
            ))
          }
        </dl>
        <a href="/office/numbers" class="mt-3 inline-block text-sm font-bold text-inherit">See all numbers</a>
      </section>
    </aside>
  </div>
</OfficeLayout>

<script>
  import { STAFF } from '../../../data/office-sample';

  // Filter the board by kind (booking request / enquiry) or by who handles it.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-kind]');
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const key = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        const show =
          key === 'all' || (key === 'mine' ? card.dataset.owner === STAFF.name : card.dataset.kind === key);
        card.hidden = !show;
      });
      document.querySelectorAll<HTMLElement>('section[aria-label]').forEach((col) => {
        const count = col.querySelector('[data-count]');
        if (count) count.textContent = String(col.querySelectorAll('[data-kind]:not([hidden])').length);
      });
    }),
  );
</script>
