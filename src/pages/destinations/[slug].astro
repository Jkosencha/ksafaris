---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import TourCard from '../../components/TourCard.astro';
import DestinationCard from '../../components/DestinationCard.astro';

export const getStaticPaths = (async () => {
  const destinations = await getCollection('destinations');
  return destinations.map((destination) => ({ params: { slug: destination.id }, props: { destination } }));
}) satisfies GetStaticPaths;

interface Props {
  destination: CollectionEntry<'destinations'>;
}

const { destination } = Astro.props;
const { name, tagline, summary, heroImage, heroAlt, facts, highlights } = destination.data;
const { Content } = await render(destination);

const tours = (await getCollection('tours', (t) => t.data.destinations.some((d) => d.id === destination.id))).sort(
  (a, b) => a.data.order - b.data.order,
);
const otherDestinations = (await getCollection('destinations'))
  .filter((d) => d.id !== destination.id)
  .sort((a, b) => a.data.order - b.data.order);

const factRows = [
  ['Capital', facts?.capital],
  ['Currency', facts?.currency],
  ['Languages', facts?.languages],
  ['Best time to visit', facts?.bestTime],
].filter(([, v]) => v);
---

<BaseLayout title={`${name} Safaris`} description={summary} image={heroImage} imageAlt={heroAlt}>
  <PageHero eyebrow={tagline} title={`${name} safaris & tours`} lead={summary} image={heroImage} imageAlt={heroAlt} />

  <nav aria-label="Breadcrumb" class="container-page pt-6 text-sm text-ink-700">
    <ol class="flex flex-wrap gap-1">
      <li><a href="/" class="hover:text-moss-700">Home</a> /</li>
      <li><a href="/destinations" class="hover:text-moss-700">Destinations</a> /</li>
      <li aria-current="page" class="text-ink-900">{name}</li>
    </ol>
  </nav>

  <div class="container-page mt-8 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="prose-safari text-lg">
      <h2 class="!mt-0">About {name}</h2>
      <Content />
    </div>

    <aside class="space-y-6 lg:self-start">
      {
        factRows.length > 0 && (
          <div class="rounded-2xl bg-white p-5 ring-1 ring-mist-200">
            <h2 class="text-lg font-semibold">Quick facts</h2>
            <dl class="mt-3 divide-y divide-mist-200 text-sm">
              {factRows.map(([k, v]) => (
                <div class="flex justify-between gap-4 py-2">
                  <dt class="text-ink-600">{k}</dt>
                  <dd class="text-right font-medium">{v}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
      <div class="rounded-2xl bg-moss-800 p-5 text-mist-50">
        <p class="font-display text-xl font-semibold text-white">Dreaming of {name}?</p>
        <p class="mt-1 text-sm text-mist-100">Tell us your dates and style and we’ll design the trip around you.</p>
        <a href="/contact#plan" class="btn-accent mt-4 w-full">Plan my safari</a>
      </div>
    </aside>
  </div>

  {
    highlights.length > 0 && (
      <section aria-labelledby="highlights" class="container-page mt-16">
        <h2 id="highlights" class="text-3xl font-semibold">Top places in {name}</h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {highlights.map((h) => (
            <li class="rounded-2xl border-l-4 border-reed-500 bg-white p-5 ring-1 ring-mist-200">
              <h3 class="text-lg font-semibold">{h.name}</h3>
              {h.description && <p class="mt-1 text-sm text-ink-700">{h.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section aria-labelledby="tours" class="container-page mt-16">
    <h2 id="tours" class="text-3xl font-semibold">{name} itineraries</h2>
    {
      tours.length > 0 ? (
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {tours.map((t) => <TourCard tour={t} />)}
        </div>
      ) : (
        <p class="mt-4 max-w-2xl text-ink-700">
          We create every {name} trip to order.{' '}
          <a href="/contact#plan" class="font-semibold text-moss-700 underline underline-offset-2">
            Tell us what you’d like to do
          </a>{' '}
          and we’ll send a tailor-made itinerary.
        </p>
      )
    }
  </section>

  <section aria-labelledby="more" class="container-page mt-16">
    <h2 id="more" class="text-3xl font-semibold">Combine with</h2>
    <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {otherDestinations.map((d) => <DestinationCard destination={d} />)}
    </div>
  </section>
</BaseLayout>
