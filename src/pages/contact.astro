---
import BaseLayout from '../layouts/BaseLayout.astro';
import heroImage from '../assets/images/placeholders/nakuru-flamingos.jpg';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { siteOf, telHref, whatsappHref } from '../lib/site';

const s = siteOf(Astro.locals);
const description = `Plan your East African safari with ${s.agencyName}. Email ${s.email} or call / WhatsApp ${s.phone}.`;
const socials = [
  { href: s.facebookUrl, icon: 'facebook' as const, label: 'Facebook' },
  { href: s.instagramUrl, icon: 'instagram' as const, label: 'Instagram' },
  { href: s.tiktokUrl, icon: 'tiktok' as const, label: 'TikTok' },
  { href: s.xUrl, icon: 'x' as const, label: 'X (Twitter)' },
].filter((l) => l.href);
const card = 'flex items-start gap-4 rounded-md bg-white p-5 ring-1 ring-mist-200 transition hover:ring-reed-500';
---

<BaseLayout title="Contact & Plan My Safari" description={description}>
  <PageHero image={heroImage} imageAlt="Thousands of pink flamingos wading in Lake Nakuru" 
        eyebrow="Contact us"
    title="Let’s plan your safari"
    lead="Tell us where you’d like to go and how you like to travel. A safari specialist will reply within one working day."
  />

  <div class="container-page mt-12 grid gap-10 lg:grid-cols-[22rem_minmax(0,1fr)]">
    <aside class="space-y-4">
      <a href={whatsappHref(s, 'Hello KSafaris, I would like to plan a safari.')} target="_blank" rel="noopener" class={card}>
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-whatsapp text-white">
          <Icon name="whatsapp" class="size-6" />
        </span>
        <span>
          <span class="block font-semibold">WhatsApp</span>
          <span class="block text-sm text-ink-700">{s.phone}</span>
        </span>
      </a>
      <a href={telHref(s)} class={card}>
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-moss-700 text-white">
          <Icon name="phone" class="size-5" />
        </span>
        <span>
          <span class="block font-semibold">Call us</span>
          <span class="block text-sm text-ink-700">{s.phone}</span>
        </span>
      </a>
      <a href={`mailto:${s.email}`} class={card}>
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-moss-700 text-white">
          <Icon name="mail" class="size-5" />
        </span>
        <span class="min-w-0">
          <span class="block font-semibold">Email</span>
          <span class="block text-sm break-all text-ink-700">{s.email}</span>
        </span>
      </a>
      <div class="rounded-md bg-mist-100 p-5">
        <p class="font-semibold">Follow our journeys</p>
        <ul class="mt-3 flex gap-3">
          {socials.map((l) => (
            <li><a href={l.href!} target="_blank" rel="noopener" class="flex size-10 items-center justify-center rounded-full bg-white ring-1 ring-mist-300 hover:text-moss-700"><Icon name={l.icon} class="size-4" label={l.label} /></a></li>
          ))}
        </ul>
        {s.address && <p class="mt-4 text-sm text-ink-700">Based in {s.address}.</p>}
      </div>
    </aside>

    <EnquiryForm />
  </div>
</BaseLayout>
