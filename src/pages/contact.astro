---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { CONTACT, SOCIAL, whatsappLink } from '../consts';

const description = `Plan your East African safari with KSafaris & African Expeditions. Email ${CONTACT.email} or call / WhatsApp ${CONTACT.phoneDisplay}.`;
const card = 'flex items-start gap-4 rounded-2xl bg-white p-5 ring-1 ring-mist-200 transition hover:ring-reed-500';
---

<BaseLayout title="Contact & Plan My Safari" description={description}>
  <PageHero
    eyebrow="Contact us"
    title="Let’s plan your safari"
    lead="Tell us where you’d like to go and how you like to travel. A safari specialist will reply within one working day."
  />

  <div class="container-page mt-12 grid gap-10 lg:grid-cols-[22rem_minmax(0,1fr)]">
    <aside class="space-y-4">
      <a href={whatsappLink('Hello KSafaris, I would like to plan a safari.')} target="_blank" rel="noopener" class={card}>
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-whatsapp text-white">
          <Icon name="whatsapp" class="size-6" />
        </span>
        <span>
          <span class="block font-semibold">WhatsApp</span>
          <span class="block text-sm text-ink-700">{CONTACT.phoneDisplay}</span>
        </span>
      </a>
      <a href={`tel:${CONTACT.phoneE164}`} class={card}>
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-moss-700 text-white">
          <Icon name="phone" class="size-5" />
        </span>
        <span>
          <span class="block font-semibold">Call us</span>
          <span class="block text-sm text-ink-700">{CONTACT.phoneDisplay}</span>
        </span>
      </a>
      <a href={`mailto:${CONTACT.email}`} class={card}>
        <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-moss-700 text-white">
          <Icon name="mail" class="size-5" />
        </span>
        <span class="min-w-0">
          <span class="block font-semibold">Email</span>
          <span class="block text-sm break-all text-ink-700">{CONTACT.email}</span>
        </span>
      </a>
      <div class="rounded-2xl bg-mist-100 p-5">
        <p class="font-semibold">Follow our journeys</p>
        <ul class="mt-3 flex gap-3">
          <li><a href={SOCIAL.facebook} target="_blank" rel="noopener" class="flex size-10 items-center justify-center rounded-full bg-white ring-1 ring-mist-300 hover:text-moss-700"><Icon name="facebook" class="size-4" label="Facebook" /></a></li>
          <li><a href={SOCIAL.instagram} target="_blank" rel="noopener" class="flex size-10 items-center justify-center rounded-full bg-white ring-1 ring-mist-300 hover:text-moss-700"><Icon name="instagram" class="size-4" label="Instagram" /></a></li>
          <li><a href={SOCIAL.x} target="_blank" rel="noopener" class="flex size-10 items-center justify-center rounded-full bg-white ring-1 ring-mist-300 hover:text-moss-700"><Icon name="x" class="size-4" label="X (Twitter)" /></a></li>
        </ul>
        <p class="mt-4 text-sm text-ink-700">Based in {CONTACT.city}, {CONTACT.country}.</p>
      </div>
    </aside>

    <EnquiryForm />
  </div>
</BaseLayout>
