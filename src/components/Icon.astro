---
import { siFacebook, siInstagram, siTripadvisor, siWhatsapp, siX } from 'simple-icons';

const brand = {
  whatsapp: siWhatsapp.path,
  facebook: siFacebook.path,
  instagram: siInstagram.path,
  x: siX.path,
  tripadvisor: siTripadvisor.path,
};

// Stroke icons (24px grid, 2px stroke).
const line = {
  mail: 'M4 6h16v12H4z M4 7l8 6 8-6',
  phone:
    'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2',
  menu: 'M4 7h16 M4 12h16 M4 17h16',
  close: 'M6 6l12 12 M18 6L6 18',
  arrow: 'M5 12h14 M13 6l6 6-6 6',
  check: 'M5 12l5 5 9-10',
  x_mark: 'M7 7l10 10 M17 7L7 17',
  pin: 'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5',
  clock: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 7v5l3 2',
  bed: 'M3 18V7 M3 14h18v4 M21 14v-2a3 3 0 0 0-3-3h-7v5 M7 11.5a1.5 1.5 0 1 0 0-.01',
  plate: 'M12 19a7 7 0 1 0 0-14 7 7 0 0 0 0 14z M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
  tag: 'M3 12V4h8l10 10-8 8z M7.5 7.5h.01',
  award: 'M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12z M8.5 13.5L7 21l5-3 5 3-1.5-7.5',
};

export type IconName = keyof typeof brand | keyof typeof line;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}

const { name, class: className = 'size-5', label } = Astro.props;
const isBrand = name in brand;
const a11y = label
  ? ({ role: 'img', 'aria-label': label } as const)
  : ({ 'aria-hidden': 'true' } as const);
---

{
  isBrand ? (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" {...a11y}>
      <path d={brand[name as keyof typeof brand]} />
    </svg>
  ) : (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      {...a11y}
    >
      <path d={line[name as keyof typeof line]} />
    </svg>
  )
}
