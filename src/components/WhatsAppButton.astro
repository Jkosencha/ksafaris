---
import { whatsappLink } from '../consts';
import Icon from './Icon.astro';

const message = 'Hello KSafaris, I’d like to plan a safari.';
---

<a
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener"
  class="fixed right-4 bottom-4 z-50 flex size-14 items-center justify-center rounded-full bg-whatsapp text-white shadow-lg shadow-bark-900/25 transition hover:scale-105 focus-visible:scale-105 sm:right-6 sm:bottom-6"
  style="margin-bottom: env(safe-area-inset-bottom);"
>
  <Icon name="whatsapp" class="size-7" label="Chat with us on WhatsApp" />
</a>
