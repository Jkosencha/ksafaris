---
import { CONTACT, whatsappLink } from '../consts';
import Icon from './Icon.astro';

interface Props {
  /** Tour title, sent with the enquiry when the form is on a tour page. */
  tour?: string;
  id?: string;
  heading?: string;
}

const { tour, id = 'plan', heading = 'Plan my safari' } = Astro.props;

// Set PUBLIC_ENQUIRY_ENDPOINT (e.g. a Formspree / Web3Forms / Netlify function URL) in .env.
// Without it the form falls back to opening a pre-filled email to the office.
const endpoint = import.meta.env.PUBLIC_ENQUIRY_ENDPOINT as string | undefined;
const action = endpoint || `mailto:${CONTACT.email}`;
const subject = tour ? `Safari enquiry: ${tour}` : 'Safari enquiry';
const waText = tour
  ? `Hello KSafaris, I'm interested in the "${tour}" tour.`
  : 'Hello KSafaris, I would like to plan a safari.';

const field =
  'mt-1 block w-full rounded-lg border border-mist-300 bg-white px-3 py-2.5 text-base text-ink-900 placeholder:text-ink-600/60 focus:border-reed-500 focus:ring-2 focus:ring-reed-300/40 focus:outline-none';
const label = 'block text-sm font-medium text-ink-800';
---

<section id={id} class="scroll-mt-28 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-mist-200 sm:p-6">
  <h2 class="text-2xl font-semibold">{heading}</h2>
  <p class="mt-1 text-sm text-ink-700">
    Tell us a little about your trip and a safari specialist will reply within one working day.
  </p>

  <form
    class="mt-5 grid gap-4 sm:grid-cols-2"
    method="post"
    action={action}
    enctype={endpoint ? undefined : 'text/plain'}
    data-enquiry-form
    data-endpoint={endpoint ?? ''}
    data-email={CONTACT.email}
  >
    <input type="hidden" name="subject" value={subject} />
    {tour && <input type="hidden" name="tour" value={tour} />}
    <div class="hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="sm:col-span-2">
      <label class={label} for={`${id}-name`}>Full name *</label>
      <input class={field} id={`${id}-name`} name="name" autocomplete="name" required />
    </div>
    <div>
      <label class={label} for={`${id}-email`}>Email *</label>
      <input class={field} id={`${id}-email`} name="email" type="email" autocomplete="email" required />
    </div>
    <div>
      <label class={label} for={`${id}-phone`}>Phone / WhatsApp</label>
      <input class={field} id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" />
    </div>
    <div>
      <label class={label} for={`${id}-country`}>Country of residence</label>
      <input class={field} id={`${id}-country`} name="country" autocomplete="country-name" />
    </div>
    <div>
      <label class={label} for={`${id}-date`}>Preferred travel month</label>
      <input class={field} id={`${id}-date`} name="travel_month" type="month" />
    </div>
    <div>
      <label class={label} for={`${id}-adults`}>Adults</label>
      <input class={field} id={`${id}-adults`} name="adults" type="number" min="1" value="2" inputmode="numeric" />
    </div>
    <div>
      <label class={label} for={`${id}-children`}>Children</label>
      <input class={field} id={`${id}-children`} name="children" type="number" min="0" value="0" inputmode="numeric" />
    </div>
    <div class="sm:col-span-2">
      <label class={label} for={`${id}-type`}>Type of travel</label>
      <select class={field} id={`${id}-type`} name="travel_type">
        <option>Individual / couple</option>
        <option>Family</option>
        <option>Group</option>
        <option>Corporate / MICE</option>
        <option>Honeymoon</option>
      </select>
    </div>
    <div class="sm:col-span-2">
      <label class={label} for={`${id}-message`}>Your ideas</label>
      <textarea
        class={field}
        id={`${id}-message`}
        name="message"
        rows="4"
        placeholder="Places you'd like to see, budget, accommodation style, special occasions…"></textarea>
    </div>

    <div class="flex flex-col gap-3 sm:col-span-2">
      <button type="submit" class="btn-primary w-full py-3 text-base">Send enquiry</button>
      <a href={whatsappLink(waText)} target="_blank" rel="noopener" class="btn w-full border border-whatsapp py-3 text-whatsapp hover:bg-whatsapp/5">
        <Icon name="whatsapp" class="size-5" />
        Or chat on WhatsApp
      </a>
      <p class="text-sm" role="status" aria-live="polite" data-form-status></p>
    </div>
  </form>
</section>

<script>
  const LABELS: Record<string, string> = {
    tour: 'Tour',
    name: 'Name',
    email: 'Email',
    phone: 'Phone / WhatsApp',
    country: 'Country',
    travel_month: 'Travel month',
    adults: 'Adults',
    children: 'Children',
    travel_type: 'Type of travel',
    message: 'Message',
  };

  document.querySelectorAll<HTMLFormElement>('[data-enquiry-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (data.get('website')) return; // honeypot

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        const body = Object.entries(LABELS)
          .filter(([key]) => data.get(key))
          .map(([key, label]) => `${label}: ${data.get(key)}`)
          .join('\n');
        const subject = String(data.get('subject') ?? 'Safari enquiry');
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = 'Your email app should open with your enquiry ready to send.';
        return;
      }

      button.disabled = true;
      status.className = 'text-sm text-ink-700';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.className = 'text-sm font-medium text-moss-700';
        status.textContent = 'Asante! Your enquiry has been sent. We’ll be in touch within one working day.';
      } catch {
        status.className = 'text-sm font-medium text-moss-700';
        status.textContent = `Sorry, something went wrong. Please email ${form.dataset.email} or message us on WhatsApp.`;
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
