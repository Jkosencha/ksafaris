---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE } from '../consts';
import { siteOf, xHandle } from '../lib/site';
import defaultOgImage from '../assets/images/placeholders/amboseli-kilimanjaro.jpg';

export interface SEOProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = defaultOgImage,
  imageAlt = 'A family of elephants walking through a flowering meadow in Amboseli, with snow-capped Mount Kilimanjaro behind',
  type = 'website',
  noindex = false,
} = Astro.props as SEOProps;

const s = siteOf(Astro.locals);
const fullTitle = title ? `${title} | ${s.agencyName}` : s.tagline ? `${s.agencyName} | ${s.tagline}` : s.agencyName;
const twitterSite = xHandle(s);
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: Math.min(1200, image.width), format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={s.agencyName} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title ?? s.agencyName} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:alt" content={imageAlt} />
{og.attributes.width && <meta property="og:image:width" content={String(og.attributes.width)} />}
{og.attributes.height && <meta property="og:image:height" content={String(og.attributes.height)} />}

<meta name="twitter:card" content="summary_large_image" />
{twitterSite && <meta name="twitter:site" content={twitterSite} />}
<meta name="twitter:title" content={title ?? s.agencyName} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
