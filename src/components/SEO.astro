---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE, SOCIAL } from '../consts';
import defaultOgImage from '../assets/images/lake-nakuru-rhinos.jpg';

export interface SEOProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  image = defaultOgImage,
  imageAlt = 'Rhinos grazing beside Lake Nakuru, Kenya',
  type = 'website',
  noindex = false,
} = Astro.props as SEOProps;

const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} — ${SITE.motto}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: image, width: Math.min(1200, image.width), format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:alt" content={imageAlt} />
{og.attributes.width && <meta property="og:image:width" content={String(og.attributes.width)} />}
{og.attributes.height && <meta property="og:image:height" content={String(og.attributes.height)} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SOCIAL.xHandle} />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
