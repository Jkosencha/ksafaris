---
import type { CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
  /** Title of the linked tour, if any (looked up by the page). */
  tourTitle?: string;
  class?: string;
}

const { review, tourTitle, class: className = '' } = Astro.props;
const { author, country, quote, rating, source, sourceUrl, date, tour, sample } = review.data;
const initial = author.trim().charAt(0).toUpperCase();
const when = date?.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
---

<figure class:list={['relative flex h-full flex-col rounded-md bg-white p-6 text-left ring-1 ring-mist-200', className]}>
  {
    sample && (
      <span class="absolute top-4 right-4 rounded-sm bg-reed-300/60 px-2 py-0.5 text-[0.65rem] font-semibold tracking-wider text-reed-700 uppercase">
        Sample review
      </span>
    )
  }
  <span aria-hidden="true" class="-mb-6 block h-12 font-display text-6xl leading-none text-reed-500">“</span>
  {
    rating && (
      <p class="mt-1 text-lg tracking-widest text-reed-500" role="img" aria-label={`${rating} out of 5 stars`}>
        {'★'.repeat(rating)}
        <span class="text-mist-300">{'★'.repeat(5 - rating)}</span>
      </p>
    )
  }
  <blockquote class="mt-3 flex-1 leading-relaxed text-ink-800">
    <p>{quote}</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-3 border-t border-mist-200 pt-4 text-sm">
    <span aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full bg-moss-700 font-display text-lg text-white">
      {initial}
    </span>
    <span class="min-w-0">
      <span class="block font-semibold text-ink-900">
        {author}{country && <span class="font-normal text-ink-700">, {country}</span>}
      </span>
      <span class="block text-ink-700">
        {tour && tourTitle && (
          <>
            <a href={`/tours/${tour.id}`} class="underline underline-offset-2 hover:text-moss-700">{tourTitle}</a>
            {' · '}
          </>
        )}
        {when && <>{when} · </>}
        via {sourceUrl ? <a href={sourceUrl} target="_blank" rel="noopener" class="underline underline-offset-2">{source}</a> : source}
      </span>
    </span>
  </figcaption>
</figure>
