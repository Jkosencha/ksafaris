---
/**
 * Full-width photo strip with torn edges, used as a breather between sections
 * (as in the Altai reference design). Optional handwritten caption over the photo.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import TornEdge from './TornEdge.astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption?: string;
  /** Fill colour of the sections above and below the band. */
  edgeColor?: string;
  class?: string;
}

const { image, alt, caption, edgeColor = 'text-mist-50', class: className = '' } = Astro.props;
---

<figure class:list={['relative isolate h-64 overflow-hidden sm:h-96', className]}>
  <Image
    src={image}
    alt={alt}
    widths={[640, 1024, 1440, 2000]}
    sizes="100vw"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  {
    caption && (
      <>
        <div class="absolute inset-0 -z-10 bg-ink-900/25" />
        <figcaption class="container-page flex h-full items-center justify-center text-center">
          <span data-reveal="zoom" class="inline-block font-hand text-3xl text-white drop-shadow-[0_2px_8px_rgb(0_0_0/0.5)] sm:text-5xl">{caption}</span>
        </figcaption>
      </>
    )
  }
  <TornEdge position="top" color={edgeColor} flip />
  <TornEdge color={edgeColor} />
</figure>
