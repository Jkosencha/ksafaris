---
import { Image } from 'astro:assets';
import tripadvisor from '../assets/images/brand/tripadvisor-badge.jpg';
import safaribookings from '../assets/images/brand/safaribookings-badge.jpg';
import { SOCIAL } from '../consts';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center gap-3', className]}>
  <li>
    <a
      href={SOCIAL.tripadvisor}
      target="_blank"
      rel="noopener"
      class="block rounded-lg bg-white p-2 shadow-sm ring-1 ring-sand-200 transition hover:ring-ochre-500"
    >
      <Image src={tripadvisor} alt="Read our reviews on Tripadvisor" class="h-14 w-auto" />
    </a>
  </li>
  <li>
    <a
      href={SOCIAL.safaribookings}
      target="_blank"
      rel="noopener"
      class="block rounded-lg bg-white p-2 shadow-sm ring-1 ring-sand-200 transition hover:ring-ochre-500"
    >
      <Image src={safaribookings} alt="Read our reviews on SafariBookings" class="h-14 w-auto" />
    </a>
  </li>
</ul>
