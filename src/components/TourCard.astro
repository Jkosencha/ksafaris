---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatPrice } from '../lib/format';

interface Props {
  tour: CollectionEntry<'tours'>;
  headingLevel?: 'h2' | 'h3';
}

const { tour, headingLevel: Heading = 'h3' } = Astro.props;
const { title, summary, durationDays, route, priceFrom, heroImage, heroAlt } = tour.data;
---

<article class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-sand-200 transition hover:shadow-md">
  <div class="relative aspect-[3/2] overflow-hidden">
    <Image
      src={heroImage}
      alt={heroAlt}
      widths={[400, 640, 850]}
      sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
      class="size-full object-cover transition duration-500 group-hover:scale-105"
    />
    <span class="absolute top-3 left-3 inline-flex items-center gap-1 rounded-full bg-bark-900/85 px-3 py-1 text-xs font-semibold text-white">
      <Icon name="clock" class="size-3.5" />
      {durationDays} days
    </span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <Heading class="text-xl leading-snug font-semibold">
      <a href={`/tours/${tour.id}`} class="after:absolute after:inset-0">{title}</a>
    </Heading>
    {route.length > 0 && <p class="mt-2 text-xs font-medium text-acacia-700">{route.join(' · ')}</p>}
    <p class="mt-3 line-clamp-3 text-sm text-bark-700">{summary}</p>
    <div class="mt-auto flex items-center justify-between pt-5 text-sm">
      <span class="font-semibold text-bark-900">{formatPrice(priceFrom)}</span>
      <span class="inline-flex items-center gap-1 font-semibold text-terracotta-700">
        View itinerary <Icon name="arrow" class="size-4 transition group-hover:translate-x-0.5" />
      </span>
    </div>
  </div>
</article>
