---
import { getCollection } from 'astro:content';
import { NAV, SITE } from '../consts';
import { siteOf, telHref } from '../lib/site';
import Icon from './Icon.astro';
import ReviewBadges from './ReviewBadges.astro';
import TornEdge from './TornEdge.astro';
import { PHOTO_CREDITS } from '../data/photo-credits';

const destinations = (await getCollection('destinations')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const s = siteOf(Astro.locals);
const socials = [
  { href: s.facebookUrl, icon: 'facebook', label: 'Facebook' },
  { href: s.instagramUrl, icon: 'instagram', label: 'Instagram' },
  { href: s.tiktokUrl, icon: 'tiktok', label: 'TikTok' },
  { href: s.xUrl, icon: 'x', label: 'X (Twitter)' },
].filter((l): l is typeof l & { href: string } => Boolean(l.href)) as { href: string; icon: 'facebook' | 'instagram' | 'tiktok' | 'x'; label: string }[];
---

<footer class="relative mt-24 bg-moss-700 pt-6 text-mist-100">
  <TornEdge position="top" />
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <p class="font-display text-2xl font-semibold text-white">{s.agencyName}</p>
      <p class="mt-2 font-hand text-2xl text-reed-300">{s.tagline}</p>
      <p class="mt-4 text-sm leading-relaxed text-mist-200">
        Locally owned and operated for over {SITE.foundedYearsAgo} years. {SITE.mission}.
      </p>
      <p class="mt-4 inline-flex items-start gap-2 text-sm text-mist-200">
        <Icon name="award" class="mt-0.5 size-4 shrink-0 text-reed-300" />
        {SITE.award}
      </p>
    </div>

    <nav aria-label="Destinations">
      <p class="text-sm font-semibold tracking-wider text-white uppercase">Destinations</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          destinations.map((d) => (
            <li>
              <a href={`/destinations/${d.id}`} class="text-mist-200 hover:text-reed-300">
                {d.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Company">
      <p class="text-sm font-semibold tracking-wider text-white uppercase">Explore</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-mist-200 hover:text-reed-300">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="text-sm font-semibold tracking-wider text-white uppercase">Get in touch</p>
      <ul class="mt-4 space-y-3 text-sm">
        <li>
          <a href={`mailto:${s.email}`} class="inline-flex items-center gap-2 break-all text-mist-200 hover:text-reed-300">
            <Icon name="mail" class="size-4 shrink-0" />
            {s.email}
          </a>
        </li>
        <li>
          <a href={telHref(s)} class="inline-flex items-center gap-2 text-mist-200 hover:text-reed-300">
            <Icon name="phone" class="size-4 shrink-0" />
            {s.phone} (tel / WhatsApp)
          </a>
        </li>
        <li class="inline-flex items-center gap-2 text-mist-200">
          <Icon name="pin" class="size-4 shrink-0" />
          {s.address}
        </li>
      </ul>
      {
        socials.length > 0 && (
          <ul class="mt-5 flex gap-3" aria-label="Social media">
            {socials.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener" class="flex size-10 items-center justify-center rounded-full bg-moss-800 hover:bg-moss-600">
                  <Icon name={l.icon} class="size-4" label={l.label} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <ReviewBadges class="mt-5" />
    </div>
  </div>

  <div class="border-t border-moss-600">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-mist-300 sm:flex-row sm:justify-between">
      <p>© {year} {s.agencyName}. All rights reserved.</p>
      <p>
        Kenya · Tanzania · Uganda · Rwanda · Zanzibar
        {PHOTO_CREDITS.length > 0 && (<> · <a href="/credits" class="underline underline-offset-2 hover:text-reed-300">Photo credits</a></>)}
      </p>
    </div>
  </div>
</footer>
