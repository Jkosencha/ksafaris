---
/**
 * Layout for the staff dashboard ("KSAFARIS office"): olive top bar with the
 * page tabs, a four-colour stripe, and a light/dark switch that remembers the
 * choice and otherwise follows the computer's setting.
 * Not linked from the public site and kept out of search engines.
 */
import '../styles/global.css';
import { ACCOUNT_LINKS, OFFICE_NAV } from '../lib/office';
import { STAFF } from '../data/office-sample';
import { ROLE_LABELS, can } from '../lib/auth/permissions';

interface Props {
  title: string;
}

const { title } = Astro.props;
const preview = Astro.locals.officePreview;
// In the local preview (no database) there is no signed-in user: show everything as an Owner would see it.
const person = Astro.locals.user ?? { name: STAFF.name, role: 'owner' as const };
const accountLinks = ACCOUNT_LINKS.filter((l) => !l.perm || can(person, l.perm));
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const under = (href: string) => path === href || path.startsWith(`${href}/`);
// Each tab the person may open, with its dropdown links (if any) filtered by their own permissions.
const tabs = OFFICE_NAV.filter((item) => can(person, item.perm)).map((item) => {
  const kids = (item.children ?? []).filter((c) => !c.perm || can(person, c.perm));
  const active = item.href === '/office' ? path === '/office' : under(item.href) || kids.some((c) => under(c.href));
  return { ...item, kids, active };
});
const tabClass = (active: boolean) => [
  'flex min-h-11 items-center gap-2 rounded-full px-3.5 text-[15px] whitespace-nowrap no-underline',
  active ? 'bg-o-pill font-bold text-o-pill-text' : 'text-o-bar-muted hover:bg-white/10',
];
---

<!doctype html>
<html lang="en" class="office">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#485342" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | KSafaris office</title>
    <script is:inline>
      // Set the theme before the page paints, so there is no flash of the wrong mode.
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('office-theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <a href="#main" class="sr-only z-50 rounded bg-white px-4 py-2 text-ink-900 focus:not-sr-only focus:fixed focus:top-2 focus:left-2">
      Skip to content
    </a>
    <header class="bg-o-bar text-o-bar-text">
      <div class="mx-auto flex min-h-17 max-w-[1360px] flex-wrap items-center gap-x-8 gap-y-3 px-4 py-3 sm:px-8">
        <a href="/office" class="font-display text-[22px] tracking-wider text-o-bar-text no-underline">
          KSAFARIS <span class="font-hand text-lg tracking-normal text-gold">office</span>
        </a>
        <nav aria-label="Dashboard" class="order-3 w-full lg:order-none lg:w-auto">
          <ul class="flex flex-wrap gap-1">
            {
              tabs.map((item) =>
                item.kids.length > 0 ? (
                  <li>
                    <details class="group relative" data-menu>
                      <summary class:list={[tabClass(item.active), 'cursor-pointer list-none [&::-webkit-details-marker]:hidden']}>
                        {item.label}
                        <svg aria-hidden="true" width="14" height="14" class="size-3.5 shrink-0 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </summary>
                      <ul class="absolute right-0 z-30 mt-2 w-56 max-w-[calc(100vw-2rem)] overflow-hidden rounded-xl bg-o-surface py-1 text-o-text shadow-xl ring-1 ring-black/10">
                        {item.kids.map((c) => (
                          <li>
                            <a
                              href={c.href}
                              aria-current={path === c.href ? 'page' : undefined}
                              class:list={['flex min-h-11 items-center px-4 text-sm text-o-text no-underline hover:bg-o-surface2', path === c.href && 'font-bold']}
                            >
                              {c.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ) : (
                  <li>
                    <a href={item.href} aria-current={item.active ? 'page' : undefined} class:list={tabClass(item.active)}>
                      {item.label}
                      {item.count !== undefined && <span class="rounded-full bg-gold px-2 text-xs font-bold text-[#2b2208]">{item.count}</span>}
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </nav>
        <div class="ml-auto flex items-center gap-2.5">
          <button
            type="button"
            data-theme-toggle
            aria-label="Switch to dark mode"
            class="flex size-11 items-center justify-center rounded-full border border-white/30 text-o-bar-text hover:bg-white/10"
          >
            <svg data-icon="moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
            <svg data-icon="sun" aria-hidden="true" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
          {
            can(person, 'bookings:manage') && (
              <a href="/office/bookings/new" class="flex h-11 items-center rounded-full bg-gold px-4 text-sm font-bold text-[#2b2208] no-underline">+ New booking</a>
            )
          }
          <details class="group relative" data-menu>
            <summary
              aria-label={`Account menu for ${person.name}`}
              class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full hover:bg-white/10 [&::-webkit-details-marker]:hidden"
            >
              <span aria-hidden="true" class="flex size-9 items-center justify-center rounded-full bg-teal font-bold text-[#0e1d1e]">{person.name.charAt(0)}</span>
            </summary>
            <div class="absolute right-0 z-30 mt-2 w-60 overflow-hidden rounded-xl bg-o-surface text-o-text shadow-xl ring-1 ring-black/10">
              <p class="bg-o-surface2 px-4 py-3 text-sm">
                <span class="block font-bold">{person.name}</span>
                <span class="text-o-muted">{ROLE_LABELS[person.role]}</span>
              </p>
              <ul class="py-1">
                {
                  accountLinks.map((l) => (
                    <li>
                      <a href={l.href} class="flex min-h-11 items-center px-4 text-sm text-o-text no-underline hover:bg-o-surface2">{l.label}</a>
                    </li>
                  ))
                }
              </ul>
              {
                !preview && (
                  <form method="post" action="/office/logout" class="border-t border-o-line">
                    <button type="submit" class="flex min-h-11 w-full items-center px-4 text-left text-sm font-semibold text-clay-ink hover:bg-o-surface2">Sign out</button>
                  </form>
                )
              }
            </div>
          </details>
        </div>
      </div>
    </header>
    <div aria-hidden="true" class="grid h-1 grid-cols-4">
      <span class="bg-teal"></span><span class="bg-gold"></span><span class="bg-clay"></span><span class="bg-leaf"></span>
    </div>
    {
      preview && (
        <p class="bg-gold-soft px-4 py-2 text-center text-sm text-gold-ink">
          <b>Preview on this computer:</b> sample data only, not connected to the database. Sign-in is switched on once the database is connected.
        </p>
      )
    }
    <main id="main" class="mx-auto flex w-full max-w-[1360px] flex-col gap-7 px-4 pt-7 pb-12 sm:px-8">
      <slot />
    </main>

    <script>
      const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const sync = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        button.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        button.querySelector('[data-icon="moon"]')!.classList.toggle('hidden', dark);
        button.querySelector('[data-icon="sun"]')!.classList.toggle('hidden', !dark);
      };
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('office-theme', next);
        } catch {
          /* private mode: the choice just isn't remembered */
        }
        sync();
      });
      sync();

      // Dropdowns (Admin, account): one open at a time; close on an outside click or Escape.
      const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-menu]')];
      menus.forEach((m) =>
        m.addEventListener('toggle', () => {
          if (m.open) menus.forEach((other) => other !== m && (other.open = false));
        }),
      );
      document.addEventListener('click', (e) => {
        menus.forEach((m) => m.open && !m.contains(e.target as Node) && (m.open = false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const open = menus.find((m) => m.open);
        if (open) {
          open.open = false;
          open.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
